---
const posts = [
  {
    img: "/images/insta-01.jpg",
    url: "https://www.instagram.com/reel/DdIFPGiSxDS/",
    alt: "モーターとファンの掃除の投稿",
  },
  {
    img: "/images/insta-02.jpg",
    url: "https://www.instagram.com/reel/DcgRYmLSqyY/",
    alt: "スポンジの掃除の投稿",
  },
  {
    img: "/images/insta-03.jpg",
    url: "https://www.instagram.com/reel/Db6valLyZlA/",
    alt: "換気扇の掃除の投稿",
  },
];
---

<section class="bg-[#F6FBF3] px-6 py-16 md:py-20">
  <div class="mx-auto max-w-4xl">
    <div class="mx-auto mb-12 max-w-[520px] text-center">
      <span
        class="mb-2.5 block text-sm font-bold tracking-[0.12em] text-[#6B8E23]"
        >INSTAGRAM</span
      >
      <h2 class="text-[26px] md:text-[34px]">Instagramの投稿</h2>
      <p class="mt-3.5 text-[15px] leading-relaxed text-[#55665A]">
        @cochi_kurashi_note の投稿より
      </p>
    </div>
    <div class="grid grid-cols-3 gap-3.5">
      {
        posts.map((post) => (
          <a
            href={post.url}
            target="_blank"
            rel="noopener"
            class="block aspect-square overflow-hidden rounded-[20px]"
          >
            <img
              src={post.img}
              alt={post.alt}
              class="h-full w-full object-cover"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>
