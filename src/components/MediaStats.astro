---
const stats = [
  { value: "112", label: "フォロワー数" },
  { value: "4ヶ月", label: "発信期間" },
  { value: "15本", label: "投稿本数" },
];
---

<section id="media-stats" class="scroll-mt-20 bg-[#F6FBF3] px-6 py-16 md:py-20">
  <div class="mx-auto max-w-4xl">
    <div class="mx-auto mb-12 max-w-[520px] text-center">
      <span
        class="mb-2.5 block text-sm font-bold tracking-[0.12em] text-[#6B8E23]"
        >MEDIA DATA</span
      >
      <h2 class="text-[26px] md:text-[34px]">メディア数値</h2>
      <p class="mt-3.5 text-[15px] leading-relaxed text-[#55665A]">
        発信を始めたばかりの、今の等身大の数字です。
      </p>
    </div>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
      {
        stats.map((stat) => (
          <div class="flex flex-col items-center gap-2.5 rounded-[28px] bg-white px-6 py-9 shadow-[0_18px_40px_-26px_rgba(70,110,80,0.3)]">
            <span class="bg-gradient-to-r from-[#3FA66B] to-[#8BC34A] bg-clip-text text-[44px] font-black text-transparent">
              {stat.value}
            </span>
            <span class="text-sm font-bold text-[#55665A]">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
