---
---

<section id="top" class="relative overflow-hidden px-6 pt-24 pb-28 md:pt-32 md:pb-36">
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(120%_90%_at_50%_-10%,#E3F3DE_0%,#F5FAF3_62%)]"
  >
  </div>
  <div
    class="absolute -top-36 -right-36 -z-10 h-[420px] w-[420px] rounded-full bg-gradient-to-br from-[#9ED8A6] to-[#C8E28A] opacity-35 blur-md"
  >
  </div>

  <div class="mx-auto flex max-w-xl flex-col items-center gap-7 text-center">
    <span
      class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-bold text-[#2E8B57] shadow-[0_2px_10px_rgba(60,130,90,0.15)]"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle
          cx="12"
          cy="12"
          r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg
      >
      PR・タイアップのご相談はこちらへ
    </span>

    <div
      class="h-[132px] w-[132px] overflow-hidden rounded-full border-[6px] border-white shadow-[0_20px_40px_-16px_rgba(63,166,107,0.45)]"
    >
      <img
        src="/images/avatar-kochi.jpg"
        alt="こち"
        class="h-full w-full object-cover"
      />
    </div>

    <div class="flex flex-col gap-2.5">
      <h1 class="text-4xl font-black md:text-5xl">こち</h1>
      <p class="text-base font-bold text-[#2E8B57]">
        暮らしの便利グッズ紹介 / インスタ発信者
      </p>
    </div>

    <p class="max-w-[460px] text-lg leading-relaxed text-[#4C5C4F]">
      使ってよかった暮らしの道具だけを、正直な言葉で紹介しています。
    </p>

    <div class="flex flex-col items-center gap-3">
      <a
        href="https://www.instagram.com/cochi_kurashi_note/"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2.5 rounded-full bg-gradient-to-r from-[#3FA66B] to-[#8BC34A] px-8 py-4.5 text-base font-bold text-[#F6FBF3] shadow-[0_14px_30px_-12px_rgba(63,166,107,0.45)] hover:brightness-105"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle
            cx="12"
            cy="12"
            r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg
        >
        Instagram DMでPR相談する
      </a>
      <span class="text-sm text-[#7A8F7C]">@cochi_kurashi_note</span>
    </div>
  </div>
</section>
